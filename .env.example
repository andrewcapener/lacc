# Environment variables required by this project.
# Fill values with:  npx vercel link  &&  npx vercel env pull .env.local
# NEXT_PUBLIC_* are browser-exposed; everything else is a server-only secret.

# --- Public (browser-exposed) ---
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SITE_URL=

# --- Server-only secrets ---
ANTHROPIC_API_KEY=
CRON_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
SANITY_API_TOKEN=
